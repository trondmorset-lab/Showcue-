<Window x:Class="ShowCue.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ShowCue"
        xmlns:m="clr-namespace:ShowCue.Models"
        xmlns:eng="clr-namespace:ShowCue.Engine"
        Title="{Binding WindowTitle}"
        Width="1400" Height="860" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="{StaticResource UiFont}">

    <Window.Resources>
        <local:EnumTextConverter x:Key="EnumText" />
        <local:ContinueGlyphConverter x:Key="ContinueGlyph" />
        <local:InverseBoolConverter x:Key="Not" />
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <local:EqualsToVisibilityConverter x:Key="EqVis" />
        <local:EqualsToVisibilityConverter x:Key="NotEqVis" Invert="True" />
        <local:MidiTriggerTextConverter x:Key="MidiText" />
        <local:NonEmptyToVisibilityConverter x:Key="NonEmptyVis" />
        <local:CueColorBrushConverter x:Key="CueBrush" />

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Faint}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <DataTemplate x:Key="EnumItem">
            <TextBlock Text="{Binding Converter={StaticResource EnumText}}" />
        </DataTemplate>

        <!-- Felles: filvelger -->
        <DataTemplate x:Key="FilePicker">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Bla …" Margin="6,0,0,0" Click="BrowseFile_Click" />
                <TextBox Text="{Binding FilePath, UpdateSourceTrigger=LostFocus}" ToolTip="{Binding FilePath}" />
            </DockPanel>
        </DataTemplate>

        <!-- ===================== Inspector-maler ===================== -->
        <DataTemplate DataType="{x:Type m:AudioCue}">
            <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="Lydfil" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FilePicker}" />
                <TextBlock Style="{StaticResource Hint}" Text="{Binding FileDuration, StringFormat='Filens lengde: {0:0.0} s'}" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="Nivå (dB)" />
                        <TextBox Text="{Binding VolumeDb}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Label}" Text="Loop" />
                        <CheckBox IsChecked="{Binding Loop}" Content="Gjenta til stoppet" Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource Label}" Text="Start og slutt" Margin="0,14,0,3" />
                <local:WaveformEditor Cue="{Binding}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Dra den grønne (start) og røde (slutt) markøren. Klikk for å flytte den blå markøren, dobbeltklikk for å lytte derfra. Musehjul zoomer, Shift+hjul ruller. Lyttingen går gjennom lydpatchen." />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="Start (s)" />
                        <TextBox Text="{Binding StartTime}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Label}" Text="Slutt (s, 0 = filslutt)" />
                        <TextBox Text="{Binding EndTime}" />
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="Fade inn (s)" />
                        <TextBox Text="{Binding FadeIn}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Label}" Text="Fade ut (s)" />
                        <TextBox Text="{Binding FadeOut}" />
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Text="Fade ut brukes ved stopp og automatisk mot slutten av fila." />

                <TextBlock Style="{StaticResource Label}" Text="Utganger (dB per filkanal → utgang)" Margin="0,14,0,3" />
                <local:RoutingMatrix Cue="{Binding}" Buses="{Binding DataContext.Buses, RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Skriv nivå i dB (0 = fullt), tomt = av. Dobbeltklikk en rute for å slå av/på. Endringer høres med en gang hvis cuen spiller. Utgangene settes opp under Lydpatch." />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="VisualCommon">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="Fade inn (s)" />
                        <TextBox Text="{Binding FadeIn}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Label}" Text="Fade ut (s)" />
                        <TextBox Text="{Binding FadeOut}" />
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource Label}" Text="Skalering" />
                <ComboBox ItemsSource="{x:Static local:EnumValues.Stretches}" SelectedItem="{Binding Stretch}" ItemTemplate="{StaticResource EnumItem}" />
                <CheckBox IsChecked="{Binding ReplaceOthers}" Content="Erstatt andre bilder/videoer (krysstoning)" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:VideoCue}">
            <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="Videofil" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FilePicker}" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="Lydnivå (dB)" />
                        <TextBox Text="{Binding VolumeDb}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Label}" Text="Loop" />
                        <CheckBox IsChecked="{Binding Loop}" Content="Gjenta til stoppet" Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VisualCommon}" />

                <TextBlock Style="{StaticResource Label}" Text="Start og slutt" Margin="0,14,0,3" />
                <local:WaveformEditor Cue="{Binding}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Dra den grønne (start) og røde (slutt) markøren. Klikk for å flytte den blå markøren, dobbeltklikk for å lytte derfra. Musehjul zoomer, Shift+hjul ruller. Lyttingen spiller lydsporet gjennom lydpatchen. Med loop hopper videoen tilbake til start ved sluttpunktet." />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="Start (s)" />
                        <TextBox Text="{Binding StartTime}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Label}" Text="Slutt (s, 0 = filslutt)" />
                        <TextBox Text="{Binding EndTime}" />
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource Label}" Text="Lydspor → utganger (dB)" Margin="0,14,0,3" />
                <TextBlock Style="{StaticResource Hint}" Text="Videoen har ikke noe lydspor." Margin="0,0,0,4"
                           Visibility="{Binding HasNoAudio, Converter={StaticResource BoolVis}}" />
                <local:RoutingMatrix Cue="{Binding}" Buses="{Binding DataContext.Buses, RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Lyden i videoen pakkes ut og spilles av ShowCue sin lydmotor, så den går gjennom lydpatchen (ASIO/Dante) og holdes i synk med bildet. «Alt av» gjør videoen stum." />
                <Button Content="Pakk ut lyd til egen lyd-cue …" HorizontalAlignment="Left" Margin="0,10,0,0" Click="ExtractVideoAudio_Click"
                        ToolTip="Lagrer lydsporet som WAV ved siden av videoen og lager en lyd-cue som starter samtidig. Videoen gjøres stum." />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:ImageCue}">
            <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="Bildefil" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FilePicker}" />
                <TextBlock Style="{StaticResource Label}" Text="Vis i (s, 0 = til stoppet)" />
                <TextBox Text="{Binding HoldTime}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VisualCommon}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:PdfCue}">
            <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="PDF-fil" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FilePicker}" />
                <TextBlock Style="{StaticResource Label}" Text="Side" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="+ Cue for neste side" Margin="6,0,0,0" Click="PdfNextPage_Click"
                            ToolTip="Lager en ny PDF-cue for neste side rett under denne" />
                    <TextBox Text="{Binding Page}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Label}" Text="Vis i (s, 0 = til stoppet)" />
                <TextBox Text="{Binding HoldTime}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VisualCommon}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:FadeCue}">
            <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="Mål-cue (nummer)" />
                <TextBox Text="{Binding Target}" />
                <TextBlock Style="{StaticResource Label}" Text="Fade-tid (s)" />
                <TextBox Text="{Binding FadeTime}" />
                <CheckBox IsChecked="{Binding FadeAudio}" Content="Fade lyd til nivå:" />
                <TextBox Text="{Binding TargetDb}" Margin="22,4,0,0" IsEnabled="{Binding FadeAudio}" />
                <TextBlock Style="{StaticResource Hint}" Margin="22,4,0,0" Text="dB. −60 eller lavere = stille." />
                <CheckBox IsChecked="{Binding FadeVisual}" Content="Fade bilde/video til synlighet (%):" />
                <TextBox Text="{Binding TargetOpacity}" Margin="22,4,0,0" IsEnabled="{Binding FadeVisual}" />
                <CheckBox IsChecked="{Binding StopWhenDone}" Content="Stopp mål-cuen når faden er ferdig" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:StopCue}">
            <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="Mål-cue (nummer, tomt = stopp alt)" />
                <TextBox Text="{Binding Target}" />
                <TextBlock Style="{StaticResource Label}" Text="Fade-tid (s)" />
                <TextBox Text="{Binding FadeTime}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:OscCue}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="IP-adresse / vertsnavn" />
                        <TextBox Text="{Binding Host}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Label}" Text="Port" />
                        <TextBox Text="{Binding Port}" />
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource Label}" Text="Adresse" />
                <TextBox Text="{Binding Address}" FontFamily="{StaticResource MonoFont}" />
                <TextBlock Style="{StaticResource Label}" Text="Argumenter" />
                <TextBox Text="{Binding Arguments}" FontFamily="{StaticResource MonoFont}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Skill med mellomrom. 1 = heltall, 0.5 = desimaltall, true/false, ellers tekst. Bruk &quot;anførselstegn&quot; for tekst med mellomrom." />
                <TextBlock Style="{StaticResource Hint}" Text="Eksempel X32: adresse /ch/01/mix/fader  argument 0.75" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:MidiCue}">
            <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="MIDI-utgang" />
                <ComboBox ItemsSource="{Binding DataContext.MidiDevices, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding Device}" />
                <TextBlock Style="{StaticResource Hint}" Text="Tom = første tilgjengelige utgang." />
                <TextBlock Style="{StaticResource Label}" Text="Meldingstype" />
                <ComboBox ItemsSource="{x:Static local:EnumValues.MidiTypes}" SelectedItem="{Binding MessageType}" ItemTemplate="{StaticResource EnumItem}" />
                <StackPanel Visibility="{Binding MessageType, Converter={StaticResource NotEqVis}, ConverterParameter=MscGo}">
                    <TextBlock Style="{StaticResource Label}" Text="Kanal (1–16)" />
                    <TextBox Text="{Binding Channel}" />
                    <TextBlock Style="{StaticResource Label}" Text="Note / program / controller (0–127)" />
                    <TextBox Text="{Binding Data1}" />
                    <StackPanel Visibility="{Binding MessageType, Converter={StaticResource EqVis}, ConverterParameter=NoteOn|ControlChange}">
                        <TextBlock Style="{StaticResource Label}" Text="Velocity / verdi (0–127)" />
                        <TextBox Text="{Binding Data2}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Visibility="{Binding MessageType, Converter={StaticResource EqVis}, ConverterParameter=MscGo}">
                    <TextBlock Style="{StaticResource Label}" Text="MSC cue-nummer" />
                    <TextBox Text="{Binding MscCueNumber}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="Device ID (127 = alle)" />
                            <TextBox Text="{Binding MscDeviceId}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Label}" Text="Command format" />
                            <TextBox Text="{Binding MscCommandFormat}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Text="Command format 1 = lys (general), 16 = lyd." />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Aktiv cue-rad -->
        <DataTemplate x:Key="ActiveTemplate" DataType="{x:Type eng:ActiveCue}">
            <Border Background="{DynamicResource Panel2}" CornerRadius="5" Padding="10,7" Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Cue.Number}" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding Cue.DisplayName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                        </DockPanel>
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="12,0" VerticalAlignment="Center" MinWidth="70">
                        <TextBlock Text="{Binding ElapsedText}" FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding RemainingText}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Wait}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Grid.Column="3" Content="■" Padding="10,4" Click="StopActive_Click" ToolTip="Stopp (med cuens fade ut)" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="230" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== Toppfelt: GO ===================== -->
        <Border Grid.Row="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource GoButton}" Content="GO" Height="92" Click="Go_Click" ToolTip="Mellomrom" />

                <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                    <TextBlock Text="NESTE CUE" Style="{StaticResource SectionHeader}" Margin="0,0,0,2" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedCue.Number}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Playhead}"
                                   FontFamily="{StaticResource MonoFont}" Margin="0,0,14,0" />
                        <TextBlock Text="{Binding NextCueTitle}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedCue.Summary}" Foreground="{DynamicResource Muted}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SelectedCue.Notes}" Foreground="{DynamicResource Wait}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock x:Name="ClockText" Text="00:00:00" FontSize="30" FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding ActiveCountText}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" FontSize="12" />
                    </StackPanel>
                    <!-- Nivåmåler -->
                    <Grid Width="26" Height="84" Margin="0,0,18,0" ToolTip="Utgangsnivå (−60 til 0 dBFS)">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="3" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource Panel3}" CornerRadius="2" />
                        <Border Grid.Column="2" Background="{DynamicResource Panel3}" CornerRadius="2" />
                        <Border x:Name="MeterL" VerticalAlignment="Bottom" Height="84" CornerRadius="2" RenderTransformOrigin="0.5,1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                    <GradientStop Color="#25B566" Offset="0" /><GradientStop Color="#25B566" Offset="0.75" />
                                    <GradientStop Color="#E3A33A" Offset="0.86" /><GradientStop Color="#E5484D" Offset="0.97" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform><ScaleTransform x:Name="MeterLScale" ScaleY="0" /></Border.RenderTransform>
                        </Border>
                        <Border x:Name="MeterR" Grid.Column="2" VerticalAlignment="Bottom" Height="84" CornerRadius="2" RenderTransformOrigin="0.5,1"
                                Background="{Binding Background, ElementName=MeterL}">
                            <Border.RenderTransform><ScaleTransform x:Name="MeterRScale" ScaleY="0" /></Border.RenderTransform>
                        </Border>
                    </Grid>
                    <Button Style="{StaticResource DangerButton}" Width="130" Height="92" Click="Panic_Click"
                            ToolTip="Esc: stopp alt med kort fade. Trykk to ganger for umiddelbar stopp.">
                        <StackPanel>
                            <TextBlock Text="STOPP ALT" FontSize="17" HorizontalAlignment="Center" />
                            <TextBlock Text="Esc" FontSize="11" Opacity="0.8" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Verktøylinje ===================== -->
        <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="8,5">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource ToolButton}" Content="Ny" Click="New_Click" ToolTip="Ctrl+N" />
                    <Button Style="{StaticResource ToolButton}" Content="Åpne" Click="Open_Click" ToolTip="Ctrl+O" />
                    <Button Style="{StaticResource ToolButton}" Content="Lagre" Click="Save_Click" ToolTip="Ctrl+S" />
                    <Button Style="{StaticResource ToolButton}" Content="Lagre som" Click="SaveAs_Click" />
                    <Rectangle Width="1" Fill="{DynamicResource Line}" Margin="8,3" />
                    <TextBlock Text="Legg til:" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="4,0,4,0" FontSize="12" />
                    <Button Style="{StaticResource ToolButton}" Content="♪ Lyd" Tag="audio" Click="AddCue_Click" ToolTip="Ctrl+1" />
                    <Button Style="{StaticResource ToolButton}" Content="▶ Video" Tag="video" Click="AddCue_Click" ToolTip="Ctrl+2" />
                    <Button Style="{StaticResource ToolButton}" Content="▣ Bilde" Tag="image" Click="AddCue_Click" ToolTip="Ctrl+3" />
                    <Button Style="{StaticResource ToolButton}" Content="▤ PDF" Tag="pdf" Click="AddCue_Click" ToolTip="Ctrl+4" />
                    <Button Style="{StaticResource ToolButton}" Content="◢ Fade" Tag="fade" Click="AddCue_Click" ToolTip="Ctrl+5 (fader valgt cue)" />
                    <Button Style="{StaticResource ToolButton}" Content="■ Stopp" Tag="stop" Click="AddCue_Click" ToolTip="Ctrl+6" />
                    <Button Style="{StaticResource ToolButton}" Content="⇢ OSC" Tag="osc" Click="AddCue_Click" ToolTip="Ctrl+7" />
                    <Button Style="{StaticResource ToolButton}" Content="♫ MIDI" Tag="midi" Click="AddCue_Click" ToolTip="Ctrl+8" />
                    <Rectangle Width="1" Fill="{DynamicResource Line}" Margin="8,3" />
                    <Button Style="{StaticResource ToolButton}" Content="Dupliser" Click="Duplicate_Click" ToolTip="Ctrl+D" />
                    <Button Style="{StaticResource ToolButton}" Content="Slett" Click="Delete_Click" ToolTip="Delete" />
                    <Button Style="{StaticResource ToolButton}" Content="↑" Click="MoveUp_Click" ToolTip="Flytt opp (Ctrl+↑)" />
                    <Button Style="{StaticResource ToolButton}" Content="↓" Click="MoveDown_Click" ToolTip="Flytt ned (Ctrl+↓)" />
                    <Button Style="{StaticResource ToolButton}" Content="Nummerer" Click="Renumber_Click" ToolTip="Gi alle cues fortløpende nummer 1, 2, 3 …" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource ToolButton}" Content="Lydpatch" Click="Patch_Click" ToolTip="Utganger og kanaler på lydkortet (Dante, ASIO, flerkanals)" />
                    <Button Style="{StaticResource ToolButton}" Content="Utgang" Click="ToggleOutput_Click" ToolTip="Vis/skjul utgangsvinduet (video, bilde, PDF)" />
                    <Button Style="{StaticResource ToolButton}" Content="Innstillinger" Click="Settings_Click" />
                    <Button Style="{StaticResource ToolButton}" Content="{Binding ThemeGlyph}" Click="ThemeToggle_Click" FontSize="15"
                            ToolTip="Bytt tema: mørk → lys → natt" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== Cueliste + inspector ===================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="360" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <Grid>
                <DataGrid x:Name="CueGrid" ItemsSource="{Binding Cues}" SelectedItem="{Binding SelectedCue, Mode=TwoWay}"
                          AllowDrop="True" Drop="CueGrid_Drop" DragOver="CueGrid_DragOver" MouseDoubleClick="CueGrid_DoubleClick">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderThickness" Value="3,0,0,0" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Color}" Value="Red">
                                    <Setter Property="Background" Value="{DynamicResource CueRed}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource CueRedStripe}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Color}" Value="Orange">
                                    <Setter Property="Background" Value="{DynamicResource CueOrange}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource CueOrangeStripe}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Color}" Value="Yellow">
                                    <Setter Property="Background" Value="{DynamicResource CueYellow}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource CueYellowStripe}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Color}" Value="Green">
                                    <Setter Property="Background" Value="{DynamicResource CueGreen}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource CueGreenStripe}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Color}" Value="Blue">
                                    <Setter Property="Background" Value="{DynamicResource CueBlue}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource CueBlueStripe}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Color}" Value="Purple">
                                    <Setter Property="Background" Value="{DynamicResource CuePurple}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource CuePurpleStripe}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Color}" Value="Gray">
                                    <Setter Property="Background" Value="{DynamicResource CueGray}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource CueGrayStripe}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource RunningRow}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Disabled}" Value="True">
                                    <Setter Property="Opacity" Value="0.4" />
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PlayheadRow}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Playhead}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="30">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Ellipse Width="9" Height="9" Fill="{DynamicResource Running}" Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}" />
                                        <Ellipse Width="9" Height="9" Fill="{DynamicResource Wait}" Visibility="{Binding IsPreWaiting, Converter={StaticResource BoolVis}}" />
                                        <TextBlock Text="!" Foreground="{DynamicResource Danger}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"
                                                   Visibility="{Binding HasError, Converter={StaticResource BoolVis}}" ToolTip="{Binding Error}" Background="Transparent" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="NR" Binding="{Binding Number}" Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource MonoFont}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="TYPE" Width="66">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TypeIcon}" Width="16" Foreground="{DynamicResource Muted}" />
                                        <TextBlock Text="{Binding TypeName}" Foreground="{DynamicResource Muted}" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="NAVN" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="3" VerticalAlignment="Bottom" Margin="0,0,0,-9"
                                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="MÅL / FIL" Binding="{Binding Summary}" Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="PRE-WAIT" Binding="{Binding PreWaitText}" Width="76">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource MonoFont}" /><Setter Property="Foreground" Value="{DynamicResource Wait}" /></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="LENGDE" Binding="{Binding DurationText}" Width="76">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource MonoFont}" /></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="" Binding="{Binding ContinueMode, Converter={StaticResource ContinueGlyph}}" Width="28">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="FontSize" Value="16" /><Setter Property="Foreground" Value="{DynamicResource Playhead}" /></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="TRIGGER" Binding="{Binding TriggerText}" Width="96">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource MonoFont}" /><Setter Property="Foreground" Value="{DynamicResource Wait}" /></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Tom liste -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="Dra lyd-, video-, bilde- eller PDF-filer hit" FontSize="18" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                    <TextBlock Text="eller bruk «Legg til» i verktøylinja" FontSize="13" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource Bg}" />

            <!-- Inspector -->
            <Border Grid.Column="2" Background="{DynamicResource Panel}">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="▶ Test" Click="TestCue_Click" Margin="0,0,4,0" ToolTip="Kjør denne cuen uten å flytte GO-markøren" />
                                    <Button Content="■" Click="StopSelected_Click" ToolTip="Stopp denne cuen" />
                                </StackPanel>
                                <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold">
                                    <Run Text="{Binding SelectedCue.TypeIcon, Mode=OneWay}" />
                                    <Run Text="{Binding SelectedCue.TypeName, Mode=OneWay}" />
                                </TextBlock>
                            </DockPanel>
                            <TextBlock Text="{Binding SelectedCue.Error}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding SelectedCue.HasError, Converter={StaticResource BoolVis}}" />

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Text="Nummer" />
                                    <TextBox Text="{Binding SelectedCue.Number}" FontFamily="{StaticResource MonoFont}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Label}" Text="Navn" />
                                    <TextBox Text="{Binding SelectedCue.Name}" />
                                </StackPanel>
                            </Grid>

                            <ContentControl Content="{Binding SelectedCue}" Focusable="False" />

                            <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,16,0,4" />
                            <TextBlock Text="AVSPILLING" Style="{StaticResource SectionHeader}" Margin="0,8,0,0" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Text="Pre-wait (s)" />
                                    <TextBox Text="{Binding SelectedCue.PreWait}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Label}" Text="Hurtigtast" />
                                    <TextBox x:Name="HotkeyBox" Text="{Binding SelectedCue.Hotkey, Mode=OneWay}" IsReadOnly="True"
                                             PreviewKeyDown="HotkeyBox_PreviewKeyDown" FontFamily="{StaticResource MonoFont}"
                                             ToolTip="Klikk her og trykk en tast (F1–F12, A–Z, 0–9). Backspace fjerner." />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Label}" Text="MIDI-trigger" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="✕" Margin="4,0,0,0" Click="MidiClear_Click" ToolTip="Fjern MIDI-trigger" />
                                <Button DockPanel.Dock="Right" Content="Lær" Margin="6,0,0,0" Click="MidiLearn_Click"
                                        ToolTip="Klikk, og trykk så en tast/knapp på MIDI-kontrolleren" />
                                <TextBox Text="{Binding SelectedCue.MidiTrigger, Mode=OneWay, Converter={StaticResource MidiText}}" IsReadOnly="True"
                                         FontFamily="{StaticResource MonoFont}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding LearnText}" Foreground="{DynamicResource Wait}"
                                       Visibility="{Binding LearnText, Converter={StaticResource NonEmptyVis}}" />
                            <TextBlock Style="{StaticResource Label}" Text="Etterpå" />
                            <ComboBox ItemsSource="{x:Static local:EnumValues.ContinueModes}" SelectedItem="{Binding SelectedCue.ContinueMode}"
                                      ItemTemplate="{StaticResource EnumItem}" />
                            <CheckBox IsChecked="{Binding SelectedCue.Disabled}" Content="Deaktivert (hoppes over av GO)" />
                            <TextBlock Style="{StaticResource Label}" Text="Farge" />
                            <ItemsControl ItemsSource="{x:Static local:EnumValues.CueColors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="26" Height="26" Margin="0,0,6,0" Padding="0" Click="CueColor_Click" Tag="{Binding}"
                                                ToolTip="{Binding Converter={StaticResource EnumText}}">
                                            <Grid>
                                                <Ellipse Width="14" Height="14" Fill="{Binding Converter={StaticResource CueBrush}}" />
                                                <Path Data="M0,14 L14,0" Stroke="{DynamicResource Faint}" StrokeThickness="1.5"
                                                      Width="14" Height="14" Visibility="{Binding Converter={StaticResource EqVis}, ConverterParameter=None}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Label}" Text="Notater (vises ved NESTE CUE)" />
                            <TextBox Text="{Binding SelectedCue.Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" />
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Text="Ingen cue valgt" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding NoSelection, Converter={StaticResource BoolVis}}" />
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource Bg}" ResizeDirection="Rows" />

        <!-- ===================== Bunn: aktive cues, hurtigknapper, forhåndsvisning ===================== -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource Panel}" Padding="12,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="AKTIVE CUES" Style="{StaticResource SectionHeader}" />
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Engine.Active}" ItemTemplate="{StaticResource ActiveTemplate}" />
                        </ScrollViewer>
                        <TextBlock Text="Ingenting spiller" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding NothingActive, Converter={StaticResource BoolVis}}" />
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource Panel}" Padding="12,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="HURTIGTASTER" Style="{StaticResource SectionHeader}" />
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding HotkeyCues}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="132" Height="62" Margin="0,0,6,6" Click="HotButton_Click" HorizontalContentAlignment="Left"
                                                VerticalContentAlignment="Top" Padding="9,6">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource RunningRow}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Running}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel>
                                                <Border Height="3" CornerRadius="1.5" Margin="0,-2,0,4" Background="{Binding Color, Converter={StaticResource CueBrush}}" />
                                                <TextBlock Text="{Binding Hotkey}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Wait}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   Visibility="{Binding NoHotkeys, Converter={StaticResource BoolVis}}"
                                   Text="Gi en cue en hurtigtast i panelet til høyre, så dukker den opp her. Hurtigtaster starter cuen uten å flytte GO-markøren." />
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="4" Background="{DynamicResource Panel}" Padding="12,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="UTGANG" Style="{StaticResource SectionHeader}" />
                    <Border Width="300" Height="169" Background="Black" CornerRadius="3" VerticalAlignment="Top">
                        <Rectangle x:Name="PreviewRect" />
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===================== Statuslinje ===================== -->
        <Border Grid.Row="5" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding RemoteStatus}" Foreground="{DynamicResource Faint}" FontSize="11.5" Margin="16,0,0,0"
                           ToolTip="Mellomrom = GO · Esc = stopp alt · ↑↓ = flytt markør · dra filer inn i lista" />
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
