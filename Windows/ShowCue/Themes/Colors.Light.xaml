    <SolidColorBrush x:Key="CueRed" Color="#F8D9DA" />
    <SolidColorBrush x:Key="CueRedStripe" Color="#D93A3F" />
    <SolidColorBrush x:Key="CueOrange" Color="#FBE3CF" />
    <SolidColorBrush x:Key="CueOrangeStripe" Color="#E07320" />
    <SolidColorBrush x:Key="CueYellow" Color="#F8F0C6" />
    <SolidColorBrush x:Key="CueYellowStripe" Color="#CFA717" />
    <SolidColorBrush x:Key="CueGreen" Color="#D7F0DF" />
    <SolidColorBrush x:Key="CueGreenStripe" Color="#2BA65C" />
    <SolidColorBrush x:Key="CueBlue" Color="#D7E5FA" />
    <SolidColorBrush x:Key="CueBlueStripe" Color="#2F6FE4" />
    <SolidColorBrush x:Key="CuePurple" Color="#E7DDF8" />
    <SolidColorBrush x:Key="CuePurpleStripe" Color="#8452E0" />
