<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fargetema: Light. Alle kontroller henter farger herfra med DynamicResource. -->
    <SolidColorBrush x:Key="Bg" Color="#E9EAEE" />
    <SolidColorBrush x:Key="Panel" Color="#F6F6F8" />
    <SolidColorBrush x:Key="Panel2" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Panel3" Color="#E6E7EB" />
    <SolidColorBrush x:Key="Line" Color="#D3D5DB" />
    <SolidColorBrush x:Key="Text" Color="#1D1E22" />
    <SolidColorBrush x:Key="Muted" Color="#5F636B" />
    <SolidColorBrush x:Key="Faint" Color="#92969E" />
    <SolidColorBrush x:Key="Go" Color="#2BA65C" />
    <SolidColorBrush x:Key="GoHover" Color="#34B868" />
    <SolidColorBrush x:Key="GoText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Running" Color="#239A55" />
    <SolidColorBrush x:Key="RunningRow" Color="#DDF2E4" />
    <SolidColorBrush x:Key="Wait" Color="#B97510" />
    <SolidColorBrush x:Key="Danger" Color="#D93A3F" />
    <SolidColorBrush x:Key="DangerHover" Color="#E54C51" />
    <SolidColorBrush x:Key="Playhead" Color="#2F6FE4" />
