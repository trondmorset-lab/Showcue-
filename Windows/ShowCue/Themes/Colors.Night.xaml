<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fargetema: Night. Alle kontroller henter farger herfra med DynamicResource. -->
    <SolidColorBrush x:Key="Bg" Color="#0A0A0B" />
    <SolidColorBrush x:Key="Panel" Color="#101012" />
    <SolidColorBrush x:Key="Panel2" Color="#151518" />
    <SolidColorBrush x:Key="Panel3" Color="#1C1C20" />
    <SolidColorBrush x:Key="Line" Color="#232328" />
    <SolidColorBrush x:Key="Text" Color="#A9A9AE" />
