    <SolidColorBrush x:Key="CueGreenStripe" Color="#2F8A52" />
    <SolidColorBrush x:Key="CueBlue" Color="#121E2F" />
    <SolidColorBrush x:Key="CueBlueStripe" Color="#3A6AB8" />
    <SolidColorBrush x:Key="CuePurple" Color="#1F182D" />
