<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fargetema: Dark. Alle kontroller henter farger herfra med DynamicResource. -->
    <SolidColorBrush x:Key="Bg" Color="#1B1C1F" />
    <SolidColorBrush x:Key="Panel" Color="#232428" />
    <SolidColorBrush x:Key="Panel2" Color="#2B2D31" />
    <SolidColorBrush x:Key="Panel3" Color="#35373C" />
    <SolidColorBrush x:Key="Line" Color="#3C3F45" />
    <SolidColorBrush x:Key="Text" Color="#E9E9EB" />
    <SolidColorBrush x:Key="Muted" Color="#9A9CA3" />
    <SolidColorBrush x:Key="Faint" Color="#686B73" />
    <SolidColorBrush x:Key="Go" Color="#30B566" />
    <SolidColorBrush x:Key="GoHover" Color="#3BC872" />
    <SolidColorBrush x:Key="GoText" Color="#08160E" />
    <SolidColorBrush x:Key="Running" Color="#34C46F" />
    <SolidColorBrush x:Key="RunningRow" Color="#1E3A2A" />
    <SolidColorBrush x:Key="Wait" Color="#E8A33D" />
    <SolidColorBrush x:Key="Danger" Color="#E5484D" />
    <SolidColorBrush x:Key="DangerHover" Color="#F05A5F" />
