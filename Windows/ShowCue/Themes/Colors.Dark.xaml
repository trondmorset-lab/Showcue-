    <SolidColorBrush x:Key="CueGreenStripe" Color="#3FB66B" />
    <SolidColorBrush x:Key="CueBlue" Color="#1F3450" />
    <SolidColorBrush x:Key="CueBlueStripe" Color="#4A8DF5" />
    <SolidColorBrush x:Key="CuePurple" Color="#34284D" />
    <SolidColorBrush x:Key="CuePurpleStripe" Color="#9B6BF2" />
